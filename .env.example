# Usage logging is optional and disabled unless explicitly enabled.
TIMEKEEPER_USAGE_LOG_ENABLED=0
TIMEKEEPER_USAGE_LOG_URL=
TIMEKEEPER_USAGE_LOG_AUTHORIZATION=
TIMEKEEPER_USAGE_LOG_APPLICATION_NAME=Time-Keeper

# Packaged builds read %LOCALAPPDATA%\TimeKeeper\.env by default.
# Set this only when the environment file lives somewhere else.
# TIMEKEEPER_ENV_FILE=C:\path\to\private\.env
